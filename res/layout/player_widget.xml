<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your music, ready." android:textColor="#FFF7ED" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open your library" android:textColor="#BFAF9E" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:id="@+id/widget_artist" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_prev" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_prev" android:tint="#FFF7ED" android:background="@android:color/transparent" android:contentDescription="Previous" />
    <ImageButton android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_play" android:tint="#FFB07A" android:background="@android:color/transparent" android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_next" android:tint="#FFF7ED" android:background="@android:color/transparent" android:contentDescription="Next" />
</LinearLayout>
